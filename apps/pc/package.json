    "@vueuse/core": "^13.4.0",
    "axios": "^1.10.0",
    "custom-shared": "workspace:^",
    "custom-theme": "workspace:^",
    "custom-ui": "workspace:^",
    "custom-utils": "workspace:^",
    "echarts": "^6.0.0",
    "less": "^4.3.0",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "4",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "web-vitals": "^5.0.3"
